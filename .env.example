# ---- AI (multi-model fallback: models whose key is missing are skipped) ----
GEMINI_API_KEY=            # https://aistudio.google.com/apikey  (also needed for scanned PDFs: vision)
GROQ_API_KEY=              # https://console.groq.com/keys (free, very fast; text PDFs only)
NVIDIA_API_KEY=            # https://build.nvidia.com (free credits; text PDFs only)
OPENROUTER_API_KEY=        # https://openrouter.ai/keys (":free" models; text PDFs only)
# OLLAMA_BASE_URL=http://localhost:11434/v1   # local model, invoices never leave the machine
# AI_CHAIN=gemini:gemini-3.6-flash,gemini:gemini-3-flash-preview,groq:llama-3.3-70b-versatile
AI_TIMEOUT_MS=45000        # per model while another model is left to try (long invoices take time)
AI_TOTAL_BUDGET_MS=120000  # whole invoice
AI_HEDGE_MS=25000          # also ask the next model if the current one is silent this long (0 = off)

# ---- delivery ----
# WEBHOOK_URL=https://hooks.zapier.com/...   # POST every result (n8n / Make / Zapier / ERP)
# WEBHOOK_SECRET=                            # adds x-signature: sha256=<hmac>
# API_KEY=                                   # required by `serve` before exposing it
# PORT=3000
# HOST=127.0.0.1

# ---- accounting exports ----
# XERO_ACCOUNT_CODE=429            # expense account for imported bills
# XERO_TAX_TYPE=Tax on Purchases
# XERO_TAX_TYPE_ZERO=No VAT
# XERO_DATE_FORMAT=DD/MM/YYYY
# QB_ACCOUNT=Office Expenses
# QB_DATE_FORMAT=MM/DD/YYYY
